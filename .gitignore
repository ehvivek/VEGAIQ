# PitMind .gitignore

# Environment
# .env is tracked intentionally for Streamlit Cloud deployment

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Trained ML models (regenerate with python core/models.py)
models/*.pkl

# FastF1 cache
cache/
*.cache

# Virtual environments
venv/
env/
.venv/

# Data files (large)
data/verstappen_abu_dhabi_2024.csv

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Streamlit secrets
.streamlit/secrets.toml

# Temp audio files
*.wav
*.mp3
temp_audio/
oggg/
